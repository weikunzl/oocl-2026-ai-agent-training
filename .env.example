# 通用 OpenAI-compatible 配置（不绑定具体供应商）
# 示例：
#   https://openrouter.ai/api/v1
#   https://api.openai.com/v1
#   https://api.deepseek.com/v1
#   http://localhost:11434/v1
LLM_BASE_URL=
LLM_MODEL=
# 云服务通常必填；本地不鉴权兼容服务可留空
LLM_API_KEY=

# 可选：04-memory Postgres 耐久 demo（本地 docker/memory-postgres）
# 默认已指向 compose 映射端口；一般无需修改
# MEMORY_DATABASE_URL=postgresql://oocl:oocl@127.0.0.1:54329/langgraph_memory?sslmode=disable
